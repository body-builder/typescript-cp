{
  "name": "typescript-cp",
  "version": "0.1.10",
  "description": "Copy non-typescript files to outDir",
  "homepage": "https://github.com/body-builder/typescript-cp#readme",
  "repository": "https://github.com/body-builder/typescript-cp",
  "bugs": {
    "url": "https://github.com/body-builder/typescript-cp/issues"
  },
  "keywords": [
    "typescript",
    "ts",
    "file",
    "asset",
    "copy",
    "watch",
    "watcher",
    "watchfile",
    "fs"
  ],
  "bin": {
    "tscp": "./dist/bin/tscp.js"
  },
  "scripts": {
    "start": "tsc -w",
    "build": "tsc",
    "lint": "eslint \"src/**/*\" --cache --max-warnings 0 --no-warn-ignored",
    "prettier": "prettier",
    "typescript": "tsc --noEmit",
    "test": "vitest --no-watch",
    "coverage": "vitest run --coverage",
    "clean": "git clean -Xdf --exclude=!node_modules --exclude=!.idea --exclude !.idea/workspace.xml",
    "release": "standard-version",
    "prepack": "pnpm run clean && pnpm run test && pnpm run build"
  },
  "engines": {
    "pnpm": "11",
    "node": ">= 20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 22"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11"
    }
  },
  "author": "Benedek Káldi",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^10.0.1",
    "cosmiconfig": "^8.1.3",
    "fs-extra": "^11.1.1",
    "globby": "^11.1.0",
    "lodash": "^4.18.1",
    "rimraf": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.2.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/json": "^2.0.1",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.16.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
